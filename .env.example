# Local Docker Compose deployment. Copy to .env before starting.
# The Go application does not load this file; Compose injects its environment.
APP_ENV=local

# Shared by PostgreSQL, Flyway and the application.
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener

# Local PostgreSQL runs without TLS.
DB_SSLMODE=disable

# Published host ports; container ports remain 5432 and 8082.
POSTGRES_PORT=5432
HTTP_PORT=8082

# Public address used to build short links.
SHORTENER_HOST=http://localhost:8082

# Local monitoring stack.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-local
